# API 서버 주소. Nginx 가 /api/* 를 Spring 으로 프록시하므로 보통 상대 경로로 둔다.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# 로컬 Spring Boot 서버. Next.js가 /api/* 요청을 이 주소로 프록시한다.
BACKEND_ORIGIN=http://127.0.0.1:8080

# 개발용 — BE 로그인(Google 인가 코드 교환)이 동작하기 전까지, 로컬 BE 키로 서명한 JWT 를 넣으면 로그인 버튼이 이 토큰으로 바로 세션을 만든다(커밋 금지).
NEXT_PUBLIC_DEV_ACCESS_TOKEN=

# Google OAuth 클라이언트 ID — 로그인 버튼이 Google 인증 화면으로 보낼 때 쓴다.
# 승인된 리디렉션 URI 에 http://localhost:3000/oauth 를 등록해야 한다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 공식 YouTube 로고 파일을 public/ 에 넣었을 때만 설정한다 (public/README.md 참고)
NEXT_PUBLIC_YOUTUBE_LOGO=

# 지역 검색(slick-address-kr, 행정안전부 도로명주소 API) 키. 비어 있으면 자체 지역 DB로 대체된다
NEXT_PUBLIC_JUSO_API_KEY=

# 카카오 로컬 REST API 키. 지하철역 검색은 Next BFF에서 호출해 브라우저에 키를 노출하지 않는다.
KAKAO_REST_API_KEY=

# 코스 상세 경로 지도(네이버 지도 API v3) - NAVER Cloud Platform 콘솔에서 발급한 Client ID
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# BE 에 아직 없는 기능(보관함 · 좋아요 동기화)을 브라우저 저장소 더미로 채운다. BE 가 준비되면 off 로 둔다.
NEXT_PUBLIC_LOCAL_DUMMY=on
